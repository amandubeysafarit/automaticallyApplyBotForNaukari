# Naukri Auto-Apply Bot Configuration Example
# Copy this file to .env and fill in your details

# Your Naukri.com login credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password

# Personal details
FIRSTNAME=Shraddha
LASTNAME=Dwivedi
PHONE=+91-7610557288

# Job search keywords (comma-separated)
KEYWORDS=OFSAA developer, sql developer, plsql developer, oracle plsql developer

# Location filter (leave empty for all locations, or specify e.g. bangalore, hyderabad, remote)
LOCATION=

# Number of search result pages to scrape per keyword (default: 2)
PAGES_PER_KEYWORD=2

# Maximum number of jobs to apply per run
MAX_APPLICATIONS=50

# Candidate Profile Details
TOTAL_EXPERIENCE=4 years
RELEVANT_EXPERIENCE=4 years
CURRENT_CTC=6 LPA
EXPECTED_CTC=10 LPA
NOTICE_PERIOD=15-30 days
CURRENT_LOCATION=Bangalore
CURRENT_COMPANY=Highpoints Technologies Pvt Ltd
KEY_SKILLS=OFSAA, SQL, PL/SQL, Oracle 12c, Python, Linux/Unix, Database Development, Performance Tuning, Jasper Reports

# Optional Gemini API Key
GEMINI_API_KEY=
