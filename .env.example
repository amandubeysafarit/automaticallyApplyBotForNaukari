# Naukri Auto-Apply Bot Configuration Example - Shreyash Gupta
# Copy this file to .env and fill in your details

# Your Naukri.com login credentials
NAUKRI_EMAIL=shreyash2025gupta@gmail.com
NAUKRI_PASSWORD=your_password

# Personal details
FIRSTNAME=Shreyash
LASTNAME=Gupta
PHONE=+91-7879946573

# Job search keywords (comma-separated)
KEYWORDS=data analyst, business analyst, power bi analyst, python data analyst, sql data analyst, junior data analyst

# Location filter (leave empty for all locations, or specify e.g. bhopal, bangalore, remote)
LOCATION=

# Number of search result pages to scrape per keyword (default: 2)
PAGES_PER_KEYWORD=2

# Maximum number of jobs to apply per run
MAX_APPLICATIONS=50

# Candidate Profile Details
TOTAL_EXPERIENCE=1 year
RELEVANT_EXPERIENCE=1 year
CURRENT_CTC=3 LPA
EXPECTED_CTC=5 LPA
NOTICE_PERIOD=Immediate
CURRENT_LOCATION=Bhopal, M.P.
CURRENT_COMPANY=Fresher / MBA Business Analytics
KEY_SKILLS=SQL, Python, Power BI, Excel, Tableau, Pandas, NumPy, Data Analytics, ETL, Business Intelligence, Data Visualization

# Optional Gemini API Key
GEMINI_API_KEY=
